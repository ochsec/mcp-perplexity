# MCP Perplexity Application Configuration

# Logging Configuration
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
PYTHONFAULTHANDLER=1

# API Keys (IMPORTANT: Replace with your actual keys)
# WARNING: Keep your API keys confidential and never commit them to version control
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Perplexity Model Configuration
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_MODEL_ASK=sonar-pro
PERPLEXITY_MODEL_CHAT=sonar-reasoning-pro

# Application Port (optional, defaults to 8000 in docker-compose)
APP_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///data/mcp_perplexity.db
DB_PATH=/app/data/perplexity.db

# Additional Environment Variables
# Uncomment and modify as needed
# ADDITIONAL_CONFIG_OPTION=value